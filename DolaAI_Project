5️⃣  dola_finetune.py 
 
python
  
import openai, json
from pathlib import Path

TRAINING_DATA = "dola_training_data.jsonl"
MODEL = "gpt-4o-mini"
SUFFIX = "dola-reviewer-v1"

training_data = [
    {"diff": "def calc(a,b): return a+b", "comment": "⚠️ Add type hints, docstring & unit tests"}
]

with open(TRAINING_DATA, "w") as f:
    for item in training_data:
        f.write(json.dumps({
            "messages": [
                {"role": "system", "content": "You are Dola AI, Senior Tech Lead. Review code for security, logic, best practices."},
                {"role": "user", "content": f"Review:\n{item['diff']}"},
                {"role": "assistant", "content": item['comment']}
            ]
        }) + "\n")

client = openai.OpenAI()
file = client.files.create(file=Path(TRAINING_DATA), purpose="fine-tune")
job = client.fine_tuning.jobs.create(training_file=file.id, model=MODEL, suffix=SUFFIX)
print(f"✅ Job ID: {job.id} | Model: ft:{MODEL}:{SUFFIX}")
 
 
6️⃣  .github/workflows/dola-ai-review.yml 
 
yaml
  
name: Dola AI Review
on:
  pull_request:
    types: [labeled, synchronize]

jobs:
  review:
    if: github.event.label.name == 'ready-to-merge'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Dola AI Scan
        uses: dola-ai/action@v1
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          openai-api-key: ${{ secrets.OPENAI_API_KEY }}
          model: "ft:gpt-4o-mini:dola-reviewer-v1"
          rules-path: ".dola/rules.yml"
      - run: gh pr edit ${{ github.event.pull_request.number }} --add-label "dola-reviewed"
        env: GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
 
 
